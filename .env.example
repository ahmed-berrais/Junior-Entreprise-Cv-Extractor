# Copy to .env and fill in. .env is gitignored: real keys never go in git, ClickUp or chat.
# Ask Ahmed for the values. On Railway each service gets only its own block.

# ── web (Next.js, repo root) ─────────────────────────────────────────────
# Browser-safe: NEXT_PUBLIC_ values are visible to anyone, so only these two.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses every database rule: never in a NEXT_PUBLIC_ name, never in client code.
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=http://localhost:3000
GEMINI_API_KEY=
# The only embedding model in this project. Same value as the worker block, always.
GEMINI_EMBED_MODEL=gemini-embedding-001
# Smart search (S3-04): a key from a SEPARATE Google project, so it never uses the CV extraction quota.
# Empty = smart search falls back to the normal search.
GEMINI_SEARCH_API_KEY=
GEMINI_SEARCH_MODEL=gemini-3.5-flash-lite
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# ── worker (Python, worker/) ─────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Asked when the main model is busy or out of quota (S1-21). Empty = no fallback.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
# The only embedding model in this project. Same value as the web block, always.
GEMINI_EMBED_MODEL=gemini-embedding-001
